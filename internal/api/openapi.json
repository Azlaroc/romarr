{
  "openapi": "3.1.0",
  "info": {
    "title": "Gamarr API",
    "description": "Self-hosted game and ROM search, download, and library manager. The HTTP/JSON API powers both the SPA and any external tooling (CLI scripts, AI agents, *arr-family integrations).",
    "version": "1.x",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Default local install"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key for programmatic access. Also accepted via ?apikey= query parameter."
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gamarr_session",
        "description": "Set by POST /api/login. Used by the SPA."
      }
    },
    "schemas": {
      "QualityProfile": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "platform_slug": {
            "type": "string",
            "maxLength": 50,
            "description": "Platform this profile overrides; empty string = global profile. Unique across profiles when non-empty."
          },
          "is_default": {
            "type": "boolean",
            "description": "Marks the global fallback profile. Setting it clears the flag on other profiles."
          },
          "region_priority": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered region preference, best first (lowered No-Intro/Redump tokens, e.g. usa, world, europe, japan)."
          },
          "format_preference": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered format preference, best first. Tokens: chd, cue, iso, gdi, zip, 7z, raw."
          },
          "prefer_1g1r": {
            "type": "boolean",
            "description": "Prefer verified dumps and latest revisions (one game, one ROM)."
          },
          "allow_proto": {
            "type": "boolean",
            "description": "Allow (Proto)/(Beta)/(Sample) releases."
          },
          "allow_demo": {
            "type": "boolean",
            "description": "Allow (Demo) releases."
          },
          "allow_bios": {
            "type": "boolean",
            "description": "Allow [BIOS] releases."
          },
          "source_ranking": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered source preference, best first."
          },
          "preferred_size_min": {
            "type": "integer",
            "format": "int64",
            "description": "Size-sanity floor in bytes; 0 = built-in per-platform default."
          },
          "preferred_size_max": {
            "type": "integer",
            "format": "int64",
            "description": "Size-sanity ceiling in bytes; 0 = built-in per-platform default."
          },
          "upgrade_allowed": {
            "type": "boolean",
            "description": "Reserved for the upgrade loop; not consumed yet."
          },
          "cutoff_source": {
            "type": "string",
            "description": "Reserved for the upgrade loop; not consumed yet."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "description": "A single game/ROM search hit. Fields are populated per source \u2014 DDL sources omit seeders/leechers; torrent sources usually omit detail-page GUIDs.",
        "properties": {
          "title": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes."
          },
          "size_human": {
            "type": "string"
          },
          "seeders": {
            "type": "integer"
          },
          "leechers": {
            "type": "integer"
          },
          "indexer": {
            "type": "string"
          },
          "download_url": {
            "type": "string",
            "format": "uri"
          },
          "magnet_url": {
            "type": "string"
          },
          "info_hash": {
            "type": "string"
          },
          "guid": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "platform_slug": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "torrent",
              "ddl"
            ]
          },
          "safety_score": {
            "type": "integer",
            "description": "0-100; higher is safer."
          },
          "score": {
            "type": "integer"
          },
          "in_library": {
            "type": "boolean"
          }
        }
      },
      "WishlistItem": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "platform": {
            "type": "string",
            "maxLength": 100
          },
          "platform_slug": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "BulkJobRequest": {
        "type": "object",
        "description": "Empty or missing job_ids means 'operate on all matching jobs' (failed for retry, active for cancel).",
        "properties": {
          "job_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 500
          }
        }
      },
      "BulkResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "requested": {
            "type": "integer"
          },
          "succeeded": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "job_id": {
                  "type": "string"
                },
                "id": {
                  "type": "integer"
                },
                "success": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "DownloadRequest": {
        "type": "object",
        "description": "POST body for /api/download. Mirrors a SearchResult row (clients may POST one verbatim) plus optional pluck and disc-set controls.",
        "required": [
          "title"
        ],
        "properties": {
          "download_url": {
            "type": "string"
          },
          "magnet_url": {
            "type": "string"
          },
          "info_hash": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "platform_slug": {
            "type": "string"
          },
          "is_pc": {
            "type": "boolean"
          },
          "source_type": {
            "type": "string",
            "description": "\"ddl\" routes to the direct downloader; anything else routes by download_protocol"
          },
          "vimm_id": {
            "type": "string"
          },
          "download_protocol": {
            "type": "string",
            "enum": [
              "torrent",
              "nzb"
            ]
          },
          "md5": {
            "type": "string",
            "description": "Expected content MD5 (archive.org); verified before a destructive convert"
          },
          "sha1": {
            "type": "string",
            "description": "Expected content SHA1"
          },
          "target_file": {
            "type": "string",
            "description": "One file to pluck out of a pack torrent (#256); empty = whole content"
          },
          "disc_set_id": {
            "type": "string",
            "description": "Disc-set membership (F4): downloads sharing an id converge into set_dir and finalize (normalize/convert/.m3u/one library row) when the last member lands. All four disc-set fields travel together."
          },
          "disc_index": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based disc number within the set"
          },
          "disc_total": {
            "type": "integer",
            "minimum": 1,
            "description": "Member count the set is complete at"
          },
          "set_dir": {
            "type": "string",
            "description": "Shared game-directory name (single path component, disc token stripped)"
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKey": []
    },
    {
      "session": []
    }
  ],
  "paths": {
    "/api/quality-profiles": {
      "get": {
        "summary": "List quality profiles",
        "description": "Per-platform selection policies (region/format priority, 1G1R flags, source ranking, size bounds).",
        "responses": {
          "200": {
            "description": "Profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "profiles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/QualityProfile"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a quality profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QualityProfile"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error (unknown region/format token, missing name)"
          },
          "409": {
            "description": "Another profile already claims the platform_slug"
          }
        }
      }
    },
    "/api/quality-profiles/{id}": {
      "put": {
        "summary": "Replace a quality profile",
        "description": "Full-body replace: omitted fields are zeroed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QualityProfile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Another profile already claims the platform_slug"
          }
        }
      },
      "delete": {
        "summary": "Delete a quality profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Liveness probe. Returns 200 if the binary is running. No auth required.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI spec",
        "description": "Returns this OpenAPI 3.1 document. AI agents can fetch this to discover endpoints.",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/status": {
      "get": {
        "summary": "Current auth state",
        "responses": {
          "200": {
            "description": "auth status"
          }
        }
      }
    },
    "/api/platforms": {
      "get": {
        "summary": "List supported gaming platforms",
        "description": "Returns the platform slugs Gamarr's drivers recognize (e.g., nes, snes, ps2, pc).",
        "responses": {
          "200": {
            "description": "platform list"
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search all configured sources for a game/ROM",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query."
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Platform slug filter, e.g. 'nes'. Omit or 'all' for cross-platform."
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SearchResult"
                      }
                    },
                    "search_time_ms": {
                      "type": "integer"
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "summary": "List configured search sources + health",
        "description": "Returns each registered source with enabled state, circuit-breaker status, last success/fail counters."
      }
    },
    "/api/sources/health": {
      "get": {
        "summary": "Detailed source health"
      }
    },
    "/api/sources/{name}/reset": {
      "post": {
        "summary": "Reset a source's circuit breaker",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reset"
          }
        }
      }
    },
    "/api/downloads": {
      "get": {
        "summary": "List active and recent downloads"
      }
    },
    "/api/downloads/{jobID}/retry": {
      "post": {
        "summary": "Retry a single failed download",
        "parameters": [
          {
            "name": "jobID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/admin/bulk/retry": {
      "post": {
        "summary": "Retry many failed jobs at once",
        "description": "Empty body retries ALL failed jobs. Otherwise retries the specified job_ids.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-id outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/bulk/cancel": {
      "post": {
        "summary": "Cancel many active jobs at once",
        "description": "Empty body cancels ALL active jobs. Otherwise cancels the specified job_ids.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-id outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/library": {
      "get": {
        "summary": "List items in the library",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/wishlist": {
      "get": {
        "summary": "List wishlist items"
      },
      "post": {
        "summary": "Add a wishlist item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WishlistItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Wrong Content-Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/wishlist/{id}": {
      "delete": {
        "summary": "Delete a wishlist item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "400": {
            "description": "Invalid id"
          }
        }
      }
    },
    "/api/wishlist/bulk-delete": {
      "post": {
        "summary": "Delete many wishlist items at once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "maxItems": 500,
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-id outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/test/prowlarr": {
      "post": {
        "summary": "Connectivity test: Prowlarr"
      }
    },
    "/api/test/qbittorrent": {
      "post": {
        "summary": "Connectivity test: qBittorrent"
      }
    },
    "/api/test/sabnzbd": {
      "post": {
        "summary": "Connectivity test: SABnzbd"
      }
    },
    "/torznab/api": {
      "get": {
        "summary": "Torznab indexer API",
        "description": "Lets Prowlarr / Sonarr / other *arr apps use Gamarr as a Torznab indexer. ?t=caps returns the capabilities document; ?t=search&q=<title> returns RSS results.",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "caps",
                "search",
                "console-search",
                "pc-search"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search query (omit for caps)."
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Gamarr platform slug filter."
          },
          {
            "name": "apikey",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Required when TORZNAB_API_KEY is set."
          }
        ],
        "responses": {
          "200": {
            "description": "Torznab XML (RSS feed or caps document)",
            "content": {
              "application/xml": {}
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics",
        "security": []
      }
    },
    "/api/download": {
      "post": {
        "summary": "Start a download (DDL, torrent, or NZB)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job created; body carries job_id and an optional duplicate-library warning"
          },
          "400": {
            "description": "Missing URL or invalid disc-set fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Get runtime settings",
        "description": "Merged runtime settings document (admin): stored DB rows where present, env-derived defaults otherwise. Keys: extract_archives, normalize_roms, convert_roms, remove_torrent_after_import, seed_janitor_enabled, scheduler_auto_download, scheduler_min_score, watcher_enabled, watcher_interval_seconds, scheduler_enabled, scheduler_interval_hours, selector_mode, selector_set_timeout_hours, romm_sync_enabled, romm_sync_interval_seconds, romm_connect_enabled, romm_exclude_platforms.",
        "responses": {
          "200": {
            "description": "Merged settings document"
          }
        }
      },
      "put": {
        "summary": "Update runtime settings",
        "description": "Sparse merge (admin): only keys present in the body change; values validate before anything applies. A JSON null deletes the stored row so the env default applies again; unknown keys are ignored. Loop-owning keys (watcher/scheduler/RomM sync/RomM Connect) re-arm their background loops synchronously before the response returns.",
        "responses": {
          "200": {
            "description": "Merged settings document after the update"
          },
          "400": {
            "description": "A declared key failed validation; nothing was applied"
          }
        }
      }
    },
    "/api/source-registry": {
      "get": {
        "summary": "List built-in source registry rows",
        "description": "The built-in driver specs (vimm, archiveorg) with enabled/base_url/mapping and the computed active flag (admin).",
        "responses": {
          "200": {
            "description": "Registry rows"
          }
        }
      }
    },
    "/api/source-registry/{name}": {
      "put": {
        "summary": "Update a built-in source spec",
        "description": "Sparse patch {enabled?, base_url?, mapping?} (admin). The registry is a closed set: unknown names 404. Writes hot-apply \u2014 the live registry swaps before the response returns.",
        "responses": {
          "200": {
            "description": "Updated row"
          },
          "400": {
            "description": "Validation failure"
          },
          "404": {
            "description": "Unknown source"
          }
        }
      }
    },
    "/api/ddl-sources": {
      "get": {
        "summary": "List DDL sources",
        "description": "The built-in Vimm display row followed by custom rows with stable ids (admin).",
        "responses": {
          "200": {
            "description": "Source rows"
          }
        }
      },
      "post": {
        "summary": "Add a custom DDL source",
        "description": "Body {name, url} (admin). Custom rows are placeholders until a generic DDL driver consumes them.",
        "responses": {
          "200": {
            "description": "{success, id}"
          },
          "400": {
            "description": "Missing name or url"
          }
        }
      }
    },
    "/api/ddl-sources/{id}": {
      "delete": {
        "summary": "Delete a custom DDL source",
        "description": "By stable id (admin); built-in rows have no id and cannot be deleted.",
        "responses": {
          "200": {
            "description": "{success}"
          },
          "404": {
            "description": "Unknown id"
          }
        }
      }
    },
    "/api/dat/authorities": {
      "get": {
        "summary": "List DAT authorities and their platform assignments (admin)",
        "description": "fetch_driver and fetch_base are data, not code: repointing an authority at a mirror, a CDN or a self-hosted clone is an edit rather than a deploy.",
        "responses": {
          "200": {
            "description": "Authorities plus every platform assignment"
          }
        }
      }
    },
    "/api/dat/authorities/{name}": {
      "patch": {
        "summary": "Update a DAT authority (admin)",
        "description": "Sparse patch of enabled, fetch_driver, fetch_base and pinned_version. A pinned version freezes automatic advance while leaving manual refresh available. fetch_base must be an absolute http(s) URL; Dat-o-Matic hosts are rejected because they ban scrapers by IP, and redump.org is rejected in favour of redump.info. Changing fetch_driver returns warnings for assignments whose dat_code no longer suits it.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authority name (no-intro, redump, mame)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "fetch_driver": {
                    "type": "string",
                    "enum": [
                      "libretro",
                      "redump",
                      "upload"
                    ]
                  },
                  "fetch_base": {
                    "type": "string"
                  },
                  "pinned_version": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated authority, plus warnings when a driver change invalidates assignments"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown authority"
          }
        }
      }
    },
    "/api/dat/authorities/{name}/refresh": {
      "post": {
        "summary": "Refresh every platform assigned to an authority (admin)",
        "description": "Fetches sequentially with a politeness delay. A platform that fails keeps its previous snapshot, and the authority's last_status becomes ok, partial or error. Responds 200 with success=false when a refresh is already running.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authority name (no-intro, redump, mame)"
          }
        ],
        "responses": {
          "200": {
            "description": "Refresh started, or already running"
          },
          "400": {
            "description": "Authority is disabled or has no automated fetch"
          },
          "404": {
            "description": "Unknown authority"
          }
        }
      }
    },
    "/api/dat/authorities/{name}/upload": {
      "post": {
        "summary": "Import a DAT by hand (admin)",
        "description": "multipart/form-data with a file part. This transport is required: raw bodies are capped at 1MB and a daily pack is tens of megabytes. With ?platform=<slug> the body is one catalog for that platform (bare, or a zip holding a single DAT). Without it, a zip is treated as a pack and fanned out across the authority's assignments, with unmatched members reported as skipped. Redump packs should name their platform, since a Redump dat_code is a system code rather than a DAT name.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authority name (no-intro, redump, mame)"
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Target platform slug for a single-catalog upload"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported platforms and skipped members"
          },
          "413": {
            "description": "Upload exceeds the size ceiling"
          },
          "415": {
            "description": "Body is not multipart/form-data"
          }
        }
      }
    },
    "/api/dat/platforms/{slug}": {
      "put": {
        "summary": "Assign a platform to a DAT authority (admin)",
        "description": "dat_code is driver-specific: the libretro mirror's DAT name without extension, or a Redump system code. The pair is validated here, since a mismatched code would otherwise fail only at fetch time. There is no delete: set enabled=false to retire an assignment.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "authority",
                  "dat_code"
                ],
                "properties": {
                  "authority": {
                    "type": "string"
                  },
                  "dat_code": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored assignment"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/dat/status": {
      "get": {
        "summary": "DAT refresh status",
        "description": "Cadence state plus the current or last run: phase, authority, progress and per-platform results.",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/api/dat/coverage": {
      "get": {
        "summary": "Owned versus catalogued, per platform",
        "description": "Two independent counts. Coverage does not match owned files against catalog entries, so the numbers are presented as 'N owned, M known' and never as a completion percentage. Nothing here asserts that a file is correct.",
        "responses": {
          "200": {
            "description": "Per-platform owned and known counts"
          }
        }
      }
    }
  }
}
